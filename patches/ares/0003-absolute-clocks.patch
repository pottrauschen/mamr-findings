diff --git a/ares/sfc/oracle.hpp b/ares/sfc/oracle.hpp
new file mode 100644
index 00000000..00532cfd
--- /dev/null
+++ b/ares/sfc/oracle.hpp
@@ -0,0 +1,22 @@
+//test-oracle instrumentation (MAMR oracle patch, not part of upstream ares)
+//all members are inert unless a front end sets them.
+struct OracleHooks {
+  //absolute clock counters since power-on; Thread::clock() is rebased at
+  //every Scheduler::exit and cannot serve as a time stamp
+  u64 cpuClocks = 0;  //master clocks (21.477 MHz), counted per CPU::step tick
+  u64 smpClocks = 0;  //SMP clock units as passed to SMP::step
+
+  //start of scanline vdisp (225, or 240 with overscan), H=0; the SMP, DSP
+  //and PPU have been synchronized to the CPU
+  void (*frame)() = nullptr;
+  //an auto-joypad read begins (before the controllers are latched)
+  void (*joypad)() = nullptr;
+  //before each CPU instruction; pc is PB:PC
+  void (*instruction)(u32 pc) = nullptr;
+  //B-bus write to $2100-$21ff that reaches the PPU (CPU or DMA)
+  void (*ppuWrite)(u8 reg, u8 data) = nullptr;
+  //APU port write: smp=false for a CPU write to $2140-$217f, smp=true for
+  //an SMP write to $f4-$f7
+  void (*apuWrite)(bool smp, u8 port, u8 data) = nullptr;
+};
+extern OracleHooks oracleHooks;
